<?xml version="1.0"?>
<robot name="slider_robot">

  <!-- ================= BASE PLATFORM ================= -->

  <link name="world"/>

<joint name="world_to_base" type="fixed">
  <parent link="world"/>
  <child link="base_link"/>
  <origin xyz="0 0 2" rpy="0 0 0"/>
</joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.5 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 1.5707 0"/>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.5 0.5 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 1.5707 0"/>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 1" rpy="0 1.5707 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0"
               iyy="0.02" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link> 

  <!-- ================= PLATFORM BLOCK ================= -->
  <link name="platform_link">
    <visual>
      <geometry>
        <box size="0.1 0.6 0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.1 0.6 0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </collision> 

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.154" ixy="0.0" ixz="0.0"
               iyy="0.008" iyz="0.0"
               izz="0.154"/>
    </inertial>
  </link>
  <link name="platform_link1">
    <visual>
      <geometry>
        <box size="0.1 0.6 0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.1 0.6 0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </collision> 

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.154" ixy="0.0" ixz="0.0"
               iyy="0.008" iyz="0.0"
               izz="0.154"/>
    </inertial>
  </link>


<!-- ===================== DRILL BLOCK ==================-->
  <link name="drill_link">
    <visual>
      <geometry>
        <box size="0.05 0.6 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 0.6 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </collision> 

    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>
  <link name="drill_link1">
    <visual>
      <geometry>
        <box size="0.05 0.6 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 0.6 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </collision> 

    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>


<!-- ===================== DRILL Rotation ================== -->
  <link name="rotor_link">
    <visual>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision> 

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0022" ixy="0.0" ixz="0.0"
               iyy="0.0022" iyz="0.0"
               izz="0.0004"/>
    </inertial>
  </link>

 <!-- ===================== VACUUM BODY================== -->
  <link name="vaccum_body_link">

    <visual>
      <geometry>
        <box size="0.1 0.1 0.15"/>
      </geometry>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <material name="blue">
        <color rgba="0.2 0.3 0.8 1"/>
      </material>
    </visual>


    <collision>
      <geometry>
        <box size="0.1 0.1 0.15"/>
      </geometry>
    </collision>


    <inertial>
      <mass value="5"/>
      <origin xyz="0 0 0"/>

      <inertia
        ixx="0.2"
        ixy="0"
        ixz="0"
        iyy="0.2"
        iyz="0"
        izz="0.2"/>
    </inertial>

  </link>
  <!-- ===================== VACUUM Rotation ================== -->
  <link name="vacuum_rotor_link">
    <visual>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision> 

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0022" ixy="0.0" ixz="0.0"
               iyy="0.0022" iyz="0.0"
               izz="0.0004"/>
    </inertial>
  </link>

   <!-- ===================== BRUSH Rotation ================== -->
  <link name="brush_rotor_link">
    <visual>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision> 

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0022" ixy="0.0" ixz="0.0"
               iyy="0.0022" iyz="0.0"
               izz="0.0004"/>
    </inertial>
  </link>

  <!--================CONTAINER==================-->
  <!-- Container link -->
  <link name="container_link">

    <!-- Visual rectangle -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.7 0.2 0.02"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0.4 1 1"/>
      </material>
    </visual>

    <!-- Collision for Gazebo -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.7 0.1 0.02"/>
      </geometry>
    </collision>

    <!-- Required for Gazebo physics -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>
  <link name="container_link1">

    <!-- Visual rectangle -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.7 0.2 0.02"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0.4 1 1"/>
      </material>
    </visual>

    <!-- Collision for Gazebo -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.7 0.1 0.02"/>
      </geometry>
    </collision>

    <!-- Required for Gazebo physics -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <link name= "clamp_link">
    <visual>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.07 0.07 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision> 

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0022" ixy="0.0" ixz="0.0"
               iyy="0.0022" iyz="0.0"
               izz="0.0004"/>
    </inertial>
  </link>



  <!--==================JOINTS====================-->
  <joint name="platform_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="platform_link"/>

   
    <origin xyz="0.06 0 0" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>
    
    <dynamics 
      damping="0.0"
      friction="0.0"/>

    <limit lower="-0.5" upper="0.5" effort="5000" velocity="5.0"/>
  </joint> 

  <joint name="drill_joint" type="prismatic">
    <parent link="platform_link"/>
    <child link="drill_link"/>

   
    <origin xyz="0.1 0 0" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <dynamics 
      damping="0.0"
      friction="0.0"/>

    <limit lower="-0.5" upper="0.5" effort="5000" velocity="0.5"/>
  </joint> 
  <joint name="rotor_joint" type="continuous">
    <parent link="drill_link"/>
    <child link="rotor_link"/>

   
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit effort="5000" velocity="50"/> 
  </joint> 

  <joint name="vaccum_fixed_joint" type="fixed">
    <parent link="platform_link"/>
    <child link="vaccum_body_link"/>

    <origin xyz="0.2 0 -0.25" rpy="0 0 0"/>

  </joint> 
  <joint name="vacuum_rotor_joint" type="continuous">
    <parent link="vaccum_body_link"/>
    <child link="vacuum_rotor_link"/>

   
    <origin xyz="0 0 0.075" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit effort="5000" velocity="50"/> 
  </joint> 
  <joint name="brush_rotor_joint" type="continuous">
    <parent link="vaccum_body_link"/>
    <child link="brush_rotor_link"/>

   
    <origin xyz="0 0 -0.075" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit effort="5000" velocity="50"/> 
  </joint> 

  
  <joint name="container_joint" type="revolute">

    <parent link="base_link"/>
    <child link="container_link"/>

    <!-- Position of rotation axis -->
    <origin xyz="-0.2 0 -0.6" rpy="0 0 1.57"/>

    <!-- Rotation axis -->
    <axis xyz="0 0 1"/>

    <limit
        lower="-1.6"
        upper="1.6"
        effort="1000"
        velocity="10.0"/>

  </joint>

  <joint name="clamp_joint" type="revolute">

    <parent link="vaccum_body_link"/>
    <child link="clamp_link"/>

    <!-- Position of rotation axis -->
    <origin xyz="0.0 0.1 0.1" rpy="0 0 0"/>

    <!-- Rotation axis -->
    <axis xyz="1 0 0"/>

    <limit
        lower="-1.6"
        upper="1.6"
        effort="100"
        velocity="20.0"/>

  </joint>

   <joint name="platform_vel_joint" type="prismatic">

    <parent link="base_link"/>
    <child link="platform_link1"/>
    <origin xyz="0 0 5" rpy="0 0 0"/>

    <!-- Rotation axis -->
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="5000" velocity="5.0"/>

  </joint>
  <joint name="drill_vel_joint" type="prismatic">

    <parent link="platform_link1"/>
    <child link="drill_link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>

    <!-- Rotation axis -->
    <axis xyz="0 0 1"/>
    <limit lower="-0.5" upper="0.5" effort="5000" velocity="5.0"/>

  </joint>
  <joint name="container_vel_joint" type="prismatic">

    <parent link="base_link"/>
    <child link="container_link1"/>
    <origin xyz="0 0 5" rpy="0 0 1.57"/>

    <!-- Rotation axis -->
    <axis xyz="0 0 1"/>
    <limit lower="-1.6" upper="1.6" effort="1000" velocity="5.0"/>

  </joint>


  <!-- <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>__CONTROLLER_CONFIG_PATH__</parameters>
    </plugin>
  </gazebo> -->
  
  <gazebo>

  <plugin
   filename="gz-sim-joint-position-controller-system"
   name="gz::sim::systems::JointPositionController">

    <joint_name>platform_joint</joint_name>

    <p_gain>5000</p_gain>
    <i_gain>0</i_gain>
    <d_gain>100</d_gain>

  </plugin>

  <plugin
    filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">

    <joint_name>drill_joint</joint_name>

    <p_gain>1500</p_gain>
    <i_gain>0</i_gain>
    <d_gain>100</d_gain>

  </plugin>

  <plugin
    filename="gz-sim-joint-controller-system"
    name="gz::sim::systems::JointController">
    <joint_name>rotor_joint</joint_name>

    <!-- <initial_velocity>0</initial_velocity> -->

  </plugin>

  <plugin
    filename="gz-sim-joint-controller-system"
    name="gz::sim::systems::JointController">
    <joint_name>vacuum_rotor_joint</joint_name>

    <!-- <initial_velocity>10</initial_velocity> -->

  </plugin>
  <plugin
    filename="gz-sim-joint-controller-system"
    name="gz::sim::systems::JointController">
    <joint_name>brush_rotor_joint</joint_name>

    <!-- <initial_velocity>-10</initial_velocity> -->

  </plugin>

  <plugin
    filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">

    <joint_name>container_joint</joint_name>

    <p_gain>50</p_gain>
    <i_gain>0</i_gain>
    <d_gain>20</d_gain>

  </plugin>

  <plugin
    filename="gz-sim-joint-position-controller-system"
    name="gz::sim::systems::JointPositionController">

    <joint_name>clamp_joint</joint_name>

    <p_gain>20</p_gain>
    <i_gain>0</i_gain>
    <d_gain>50</d_gain>

  </plugin>

  
  <plugin
  filename="gz-sim-joint-state-publisher-system"
  name="gz::sim::systems::JointStatePublisher"/>

  </gazebo>

  <!-- <ros2_control name="GazeboSimSystem" type="system"> -->
  <ros2_control name= "SamplerHardwareSystem" type="system">
    <!-- <hardware>SamplerHardwareSystem
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware> -->

    <hardware>
      <plugin>sampler_hardware_interfaces/SamplerHardware</plugin>
    </hardware>

    <joint name="platform_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="drill_joint">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

     <joint name="rotor_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="vacuum_rotor_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="brush_rotor_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="container_joint">

    <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>

    <joint name="clamp_joint">

      <command_interface name="position"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>

    <joint name="platform_vel_joint">

      <command_interface name="velocity"/>

      <!-- <state_interface name="position"/>
      <state_interface name="velocity"/> -->

    </joint>

    <joint name="drill_vel_joint">

      <command_interface name="velocity"/>

      <!-- <state_interface name="position"/>
      <state_interface name="velocity"/> -->

    </joint>

    <joint name="container_vel_joint">

      <command_interface name="velocity"/>

      <!-- <state_interface name="position"/>
      <state_interface name="velocity"/> -->

    </joint>
    
  </ros2_control>



</robot>

